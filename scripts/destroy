#!/usr/bin/env bash
# shellcheck source=lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

HOST="${1:-}"
[ -n "$HOST" ] || usage "destroy <hostname>"

echo "broo, this will destroy server '$HOST' and its dns records."
echo "review the plan below before approving."
echo

write_inventory
run_tofu destroy -target="module.stack[\"$HOST\"]"
